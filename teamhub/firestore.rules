rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ── Teams (Brophy: JVB + JVA + Varsity under one account) ──────────
    // A user belongs to one or more teams: `teamIds[]` + `primaryTeamId` on
    // their users/{uid} doc (set from the invite at first sign-in).
    // Every team-scoped doc carries a `teamId` field; every rule below
    // requires the caller to be on that team. A doc with no teamId (legacy)
    // is unreadable — fail closed.
    function isTeamId(id) { return id == 'jvb' || id == 'jva' || id == 'varsity'; }
    // teamId of the doc being read/updated/deleted ('' if absent → deny).
    function rTeam() { return resource.data.get('teamId', ''); }
    // teamId of the doc being created.
    function wTeam() { return request.resource.data.get('teamId', ''); }
    // The write must not move a doc to another team.
    function teamUnchanged() { return request.resource.data.get('teamId', '') == resource.data.get('teamId', ''); }

    // The caller's user doc (null when it doesn't exist yet — a brand-new
    // user has no doc until the invite gate creates one).
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole() {
      let d = me();
      return d == null ? 'player' : d.get('role', 'player');
    }
    function myTeamIds() {
      let d = me();
      return d == null ? [] : d.get('teamIds', []);
    }
    function isOrgAdmin() { return signedIn() && myRole() == 'orgAdmin'; }
    // Any coach-level role (a per-team coach or the org admin). Used for
    // shared (non-team) collections only; team-scoped writes use isCoachOf.
    function isAdmin() { return signedIn() && (myRole() == 'admin' || myRole() == 'orgAdmin'); }
    // The caller belongs to this team (org admin belongs to all three).
    function isMemberOf(teamId) { return signedIn() && (isOrgAdmin() || myTeamIds().hasAny([teamId])); }
    // The caller coaches this team (org admin coaches all three).
    function isCoachOf(teamId) { return signedIn() && (isOrgAdmin() || (myRole() == 'admin' && myTeamIds().hasAny([teamId]))); }
    // The caller is a per-team coach of this team (role 'admin' on it).
    // Unlike isCoachOf, this EXCLUDES the org admin: DMs are between a
    // player and their own team's coach only — a player never DMs the org
    // admin, and the org admin never reads or replies in a DM thread
    // (decision 2026-11-08).
    function isTeamCoachOf(teamId) { return signedIn() && myRole() == 'admin' && myTeamIds().hasAny([teamId]); }
    // The caller shares at least one team with the given teamIds list.
    function sharesTeam(teamIds) { return signedIn() && (isOrgAdmin() || myTeamIds().hasAny(teamIds)); }
    // Team-scoped write helpers.
    function coachCreate() { return isCoachOf(wTeam()) && isTeamId(wTeam()); }
    function coachUpdate() { return isCoachOf(rTeam()) && teamUnchanged(); }
    function coachDelete() { return isCoachOf(rTeam()); }

    // The audience keys the current user satisfies. A doc with an
    // `audienceKeys` array is readable if it contains any of these (or '*').
    // Missing `audienceKeys` defaults to ['*'] (everyone) for back-compat.
    // Roster emails are lowercased at invite time but an auth token's email can
    // carry the case the user typed, so we match both spellings.
    function myAudienceKeys() {
      return ['*',
              'uid:' + request.auth.uid,
              'email:' + (request.auth.token.email == null ? '' : request.auth.token.email),
              'email:' + (request.auth.token.email == null ? '' : request.auth.token.email.lower())];
    }
    function inAudience() {
      return signedIn() &&
        resource.data.get('audienceKeys', ['*']).hasAny(myAudienceKeys());
    }
    // Whether `msg` is a legitimate post by the current player: into a channel
    // they can see, carrying an audience no wider than that channel's, with
    // themselves inside it, and not masquerading as a coach (`isCoach` is what
    // drives the coach styling in the chat UI, and the client sets it freely).
    // Team-scoped: the message must belong to a team the poster is on, and a
    // group channel's team must match the message's team (so a JVB player
    // can't post a Varsity message into a JVB channel or vice versa).
    // The "team" channel has no doc — its team is the message's teamId.
    // Resolves the channel once — rules cap document lookups per request.
    function canPostAsPlayer(msg) {
      let ch = msg.get('channel', 'team');
      let chDoc = ch == 'team' ? null : get(/databases/$(database)/documents/chatGroups/$(ch)).data;
      let chKeys = chDoc == null ? ['*'] : chDoc.get('audienceKeys', ['*']);
      let chTeam = chDoc == null ? '' : chDoc.get('teamId', '');
      let msgKeys = msg.get('audienceKeys', ['*']);
      let mine = myAudienceKeys();
      let teamId = msg.get('teamId', '');
      return isMemberOf(teamId)
        && (chTeam == '' || chTeam == teamId)
        && chKeys.hasAny(mine)
        && msgKeys.hasOnly(chKeys)
        && msgKeys.hasAny(mine)
        && msg.get('isCoach', false) == false;
    }

    // Teams: the three Brophy teams. Coaches may create their own team's doc
    // if it's missing (the app seeds it on first login); only the org admin
    // may change or delete a team.
    match /teams/{teamId} {
      allow read:   if isOrgAdmin() || isMemberOf(teamId);
      allow create: if isCoachOf(teamId);
      allow update, delete: if isOrgAdmin();
    }

    // Profiles: anyone on a shared team can read; you create your own; a
    // coach edits users on their team (org admin: anyone); only admin
    // changes roles. A signed-in user can update their own doc, but only the
    // FCM-token and notification-pref fields (so they can opt themselves
    // in/out of push without being able to grant themselves admin) — plus a
    // one-time backfill of their own teamIds/primaryTeamId when the doc
    // predates teams (a fresh project never hits this).
    match /users/{uid} {
      allow read:   if isOwner(uid) || isOrgAdmin() || sharesTeam(resource.data.get('teamIds', []));
      allow create: if isOwner(uid);
      // Team assignment (teamIds / primaryTeamId) AND role are org-admin-only:
      // a player may never change their own teams, and a team coach may never
      // move a player between teams (JVB -> JVA -> Varsity), add a second
      // team, or promote/demote anyone — only the org admin (who sees all
      // three teams) does that. A coach may still edit the other profile
      // fields of a player they share a team with (photo, name, notification
      // prefs); a player edits only their own profile fields. There is
      // deliberately NO self-backfill clause for teamIds: a user doc is
      // created with its teams in useAuth, and the hook degrades to in-memory
      // values if a write is denied.
      allow update: if isOrgAdmin()
        || (isAdmin() && sharesTeam(resource.data.get('teamIds', []))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teamIds', 'primaryTeamId', 'role']))
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['fcmTokens', 'notificationsEnabledAt', 'name', 'initials', 'photoURL', 'photoPath']));
      allow delete: if isOrgAdmin() || (isAdmin() && sharesTeam(resource.data.get('teamIds', [])));
    }

    // Announcements: team-scoped. Coach of the team writes; members read.
    match /announcements/{id} {
      allow read:   if isMemberOf(rTeam());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }
    // Events carry an audience: coach reads all on their team, a player only
    // reads events addressed to them (everyone / their group / them specifically).
    match /events/{id} {
      allow read:   if isCoachOf(rTeam()) || (isMemberOf(rTeam()) && inAudience());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }
    // Shared libraries (no teamId — one library for all three Brophy teams).
    match /videos/{id}        { allow read: if signedIn(); allow write: if isAdmin(); }
    match /drills/{id}          { allow read: if signedIn(); allow write: if isAdmin(); }
    // Drill library (standalone Brophy Drill Library site): public read,
    // coach-only write. Anyone (signed in or not) can read — the library is
    // public. Only coaches (role admin or orgAdmin) can add/edit/delete, and
    // the creator must be the signed-in user with a non-empty name. Merged
    // from the drill-library repo's firestore.rules — deploy once with the
    // app's rules, never deploy the library's file on its own (it would
    // overwrite the app's rules).
    match /drillLibrary/{drillId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if isAdmin();
    }
    match /practices/{id} {
      allow read:   if isMemberOf(rTeam());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }
    match /programs/{id} {
      allow read:   if isMemberOf(rTeam());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }
    // Game-day starting line-ups: coach builds/saves; everyone on the team reads.
    match /lineups/{id} {
      allow read:   if isMemberOf(rTeam());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }
    match /customExercises/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Team documents: coach of the team uploads/deletes; any member of the
    // team may add their own signature (only the `signatures` field), like
    // message readBy/votes.
    match /documents/{id} {
      allow read:   if isMemberOf(rTeam());
      allow create: if coachCreate();
      allow delete: if coachDelete();
      allow update: if coachUpdate()
        || (isMemberOf(rTeam()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatures']));
    }

    // Group chats (channels): coach of the team creates/deletes + sets
    // visibility. A hidden channel is only readable by its audience (enforced
    // server-side via audienceKeys) on that team; its messages are gated the
    // same way below. Coaches can also edit membership after creation, which
    // rewrites `visibleTo` + `audienceKeys` and re-stamps the channel's
    // messages. Any edit that touches the audience must leave a non-empty
    // `audienceKeys` behind, so enforcement can never be dropped by an edit;
    // edits that don't touch it (e.g. pin/rename) are unaffected, including
    // on pre-backfill docs.
    match /chatGroups/{id} {
      allow read: if isCoachOf(rTeam()) || (isMemberOf(rTeam()) && inAudience());
      allow create: if coachCreate();
      allow delete: if coachDelete();
      allow update: if coachUpdate() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['visibleTo', 'audienceKeys'])
        || (request.resource.data.audienceKeys is list
            && request.resource.data.audienceKeys.size() > 0)
      );
    }

    // Direct messages with the team's coach: a player can read/write only
    // their own thread (threadId == their uid) on their team; a coach of
    // that team can read/write any thread on their team. The org admin is
    // NOT a DM participant — players DM their own team's coach only, so
    // these rules use isTeamCoachOf, not isCoachOf (decision 2026-11-08).
    // Any team member may mark a message read (only the `readBy` map), like
    // message readBy; only the team's coach deletes.
    match /dms/{id} {
      allow read:   if isTeamCoachOf(rTeam()) || (signedIn() && resource.data.threadId == request.auth.uid && isMemberOf(rTeam()));
      allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid
                    && isMemberOf(wTeam())
                    && (isTeamCoachOf(wTeam()) || request.resource.data.threadId == request.auth.uid);
      allow update: if isTeamCoachOf(rTeam())
        || (signedIn() && resource.data.threadId == request.auth.uid && isMemberOf(rTeam())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isTeamCoachOf(rTeam());
    }

    // App-wide prompts (e.g. "everyone update your profile"): coach sets, all read.
    match /appConfig/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Scheduled reminders + polls: coach-only, team-scoped. A Cloud Function
    // (admin SDK, bypasses rules) fires them at their sendAt time.
    match /scheduled/{id} {
      allow read:   if isCoachOf(rTeam());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }

    // Custom push notifications: the coach's own messages (send now, schedule,
    // or recurring), team-scoped. A Cloud Function (admin SDK, bypasses rules)
    // fires them at their sendAt time and records sends. Players can read only
    // the notifications addressed to them (same audienceKeys pattern as
    // announcements); the coach of the team manages the queue.
    match /pushNotifications/{id} {
      allow read:   if isCoachOf(rTeam()) || (isMemberOf(rTeam()) && inAudience());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }

    match /recipes/{id}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /categories/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }
    // Quote of the Day: one per team; coach of the team posts, members read.
    match /quotes/{id} {
      allow read:   if isMemberOf(rTeam());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }

    // Chat: anyone on the team can post as themselves; only the team's coach
    // edits/deletes/pins. Reads are scoped to the message's team AND audience
    // (copied from its channel), so a player never receives messages from a
    // channel they can't see — or from another team.
    match /messages/{id} {
      allow read:   if isCoachOf(rTeam()) || (isMemberOf(rTeam()) && inAudience());
      // A message copies its channel's audience at post time, so that audience
      // has to be checked against the channel rather than taken on trust from
      // the client (see canPostAsPlayer). Coaches post freely on their team.
      // Note: a player posting in the instant between a coach narrowing a
      // channel and their own snapshot catching up is denied and must retry —
      // failing closed is the right side to err on for a privacy control.
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && (isCoachOf(wTeam()) || canPostAsPlayer(request.resource.data));
      // Coach can edit/pin/delete. Any team member can mark messages read
      // (readBy), vote on a poll (votes) or react — but only those fields,
      // and only on messages they're still in the audience for. Without the
      // audience check a player removed from a channel could keep voting on
      // and reacting to its polls using ids they collected while they were a
      // member.
      allow update: if coachUpdate()
        || (isMemberOf(rTeam()) && inAudience() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']))
        || (isMemberOf(rTeam()) && inAudience() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']))
        || (isMemberOf(rTeam()) && inAudience() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
      allow delete: if coachDelete();
    }

    // Wellness: player writes only their own, on a team they're on; coach
    // reads their team's.
    match /wellnessCheckins/{docId} {
      allow read:  if isCoachOf(rTeam()) || isOwner(resource.data.uid);
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid && isMemberOf(wTeam());
      allow delete: if coachDelete();
    }

    // Wellness nudge markers: one doc per player per day (id =
    // `${uid}_${date}`), written only by the Cloud Function (admin SDK,
    // bypasses rules) so a player is never nudged twice in one day, even
    // across teams. Clients never write these; the coach may read their
    // team's markers.
    match /wellnessNudges/{id} {
      allow read:  if isCoachOf(rTeam());
      allow create, update, delete: if false;
    }

    // Food log: completely private to each player
    match /logs/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid);
    }

    // Saved / favorite foods: private per player, for one-tap re-logging.
    match /logs/{uid}/savedFoods/{id} {
      allow read, write: if isOwner(uid);
    }

    // The player's OWN daily nutrition goal (calories + protein, optional).
    // Set by the player, for the player — no coach sets or reads it here.
    // Stored as a document inside the goals subcollection (4 segments) so
    // the path is a valid Firestore document reference.
    match /logs/{uid}/goals/{goalId} {
      allow read, write: if isOwner(uid);
    }

    // Personal workouts: completely private to each player
    match /users/{uid}/workouts/{wid} {
      allow read, write: if isOwner(uid);
    }

    // Team-published workouts: team members read, only their coach writes
    match /teamWorkouts/{wid} {
      allow read:   if isMemberOf(rTeam());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }

    // Invite roster: a coach manages their team's invites; any signed-in user
    // can read their own invite (so the first-login gate works) or an invite
    // for a team they're on.
    match /invitedEmails/{email} {
      allow read:  if signedIn() && (
        email == (request.auth.token.email == null ? '' : request.auth.token.email.lower())
        || isOrgAdmin()
        || isMemberOf(resource.data.get('teamId', '')));
      allow create: if coachCreate();
      // Role changes on a roster entry are org-admin-only (decision
      // 2026-11-08) — the `role` field is what a future first-sign-in
      // inherits, so a team coach changing it would be a back-door
      // promotion. A coach may still update other fields (none in use
      // today) and delete entries; only the org admin touches `role`.
      allow update: if isOrgAdmin()
        || (coachUpdate() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if coachDelete();
    }

    // Team invite LINKS (decision 2026-11-08): a coach generates a link for
    // ONE team; a player signing up via that link lands on that team. Shape:
    //   inviteLinks/{code} = { teamId, createdByUid, createdByName, code,
    //     createdAt, expiresAt (timestamp or null = never expires),
    //     maxUses (number or null = unlimited), uses (number) }
    // The doc id IS the code (a random token) — knowing the code is the
    // capability to redeem it. Generation UI lives in HomePage (roster),
    // redemption in useAuth.js at first sign-in; the rules below enforce it:
    //  - create: a coach of the team (or org admin) mints a link for their team.
    //  - get: anyone signed in who knows the exact code (redemption lookup).
    //  - list: only coaches of that team / org admin (so players can't
    //    enumerate every team's codes).
    //  - update: coach/org admin may change expiry/cap; anyone signed in may
    //    bump `uses` by exactly 1 while the link is live (the redemption
    //    increment) — nothing else.
    //  - delete: org admin, or the coach who created the link.
    match /inviteLinks/{code} {
      allow get:   if signedIn();
      allow list:  if isCoachOf(rTeam());
      allow create: if isCoachOf(wTeam()) && isTeamId(wTeam())
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.get('code', '') == code
        && request.resource.data.get('uses', -1) == 0
        && request.resource.data.diff({}).affectedKeys()
             .hasOnly(['teamId', 'createdByUid', 'createdByName', 'code', 'createdAt', 'expiresAt', 'maxUses', 'uses']);
      allow update: if isOrgAdmin()
        || (isCoachOf(rTeam())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt', 'maxUses']))
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
            && request.resource.data.uses == resource.data.get('uses', 0) + 1
            && (resource.data.get('maxUses', null) == null
                || request.resource.data.uses <= resource.data.get('maxUses', 0))
            && (resource.data.get('expiresAt', null) == null
                || resource.data.expiresAt > request.time));
      allow delete: if isOrgAdmin()
        || (isCoachOf(rTeam()) && resource.data.createdByUid == request.auth.uid);
    }

    // Water tracking: one doc per player per day. Player writes own, reads own.
    match /water/{docId} {
      allow read:  if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Meal log activity: small "did this player log today" markers so the
    // coach can see compliance without reading what they actually ate.
    // Team-scoped: a coach sees only their team's markers.
    match /mealLogActivity/{docId} {
      allow read:  if isCoachOf(rTeam()) || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid && isMemberOf(wTeam());
      allow delete: if coachDelete();
    }

    // Personal calendar events: completely private to each player.
    match /users/{uid}/personalEvents/{id} {
      allow read, write: if isOwner(uid);
    }

    // Groups: coach of the team manages; team members can read so the
    // visibility filter works.
    match /groups/{id} {
      allow read:   if isMemberOf(rTeam());
      allow create: if coachCreate();
      allow update, delete: if coachUpdate() || coachDelete();
    }
  }
}
