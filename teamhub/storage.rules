rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The audience keys the caller satisfies — mirrors firestore.rules so a
    // chat image is readable only by the same people who can read its channel.
    function myAudienceKeys() {
      return ['*',
              'uid:' + request.auth.uid,
              'email:' + (request.auth.token.email == null ? '' : request.auth.token.email),
              'email:' + (request.auth.token.email == null ? '' : request.auth.token.email.lower())];
    }
    function myUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function myRole() {
      let d = myUserData();
      return d == null ? 'player' : d.get('role', 'player');
    }
    function myTeamIds() {
      let d = myUserData();
      return d == null ? [] : d.get('teamIds', []);
    }
    function isOrgAdminUser() { return request.auth != null && myRole() == 'orgAdmin'; }
    function isAdminUser() {
      return request.auth != null && (myRole() == 'admin' || myRole() == 'orgAdmin');
    }
    function isMemberOfTeam(teamId) {
      return request.auth != null && (isOrgAdminUser() || myTeamIds().hasAny([teamId]));
    }
    // The caller has a users/{uid} profile (passed the invite gate). A bare
    // signed-in account with no profile reads nothing.
    function hasProfile() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    // A coach of this team: the org admin (coaches all three) or a per-team
    // coach (role admin with this team in teamIds).
    function isTeamCoach(teamId) {
      return request.auth != null
        && (myRole() == 'orgAdmin' || (myRole() == 'admin' && myTeamIds().hasAny([teamId])));
    }
    // A per-team coach of this team ONLY — the org admin is excluded, same
    // as the Firestore DM rules (DMs are between a player and their own
    // team's coach; decision 2026-11-08).
    function isPerTeamCoach(teamId) {
      return request.auth != null && myRole() == 'admin' && myTeamIds().hasAny([teamId]);
    }
    // Shared-library uploads (drills, drill PDFs): coaches and drill builders.
    function canBuildDrills() {
      return request.auth != null && myRole() in ['admin', 'orgAdmin', 'drillBuilder'];
    }
    // The caller shares at least one team with the user who owns `uid`'s
    // profile (used for avatars). Returns false when either doc is missing.
    // NOTE: Storage rules functions are single expressions — `if` statements
    // are not allowed here (the compiler rejects them), so this is a ternary
    // chain with a `let` binding, same semantics as the Firestore version.
    function sharesTeamWith(uid) {
      let other = request.auth == null ? null : firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return request.auth == null ? false
        : isOrgAdminUser() || request.auth.uid == uid ? true
        : other == null ? false
        : myTeamIds().hasAny(other.get('teamIds', []));
    }

    // Chat images, videos and files. Path shape: chat/{teamId}/{channel}/{uid}/{filename},
    // where channel is the chatGroup id ("team" = the team's main channel).
    // The team segment is what isolates the three Brophy teams: a caller can
    // only read/write under a team they're on. Reads are additionally
    // gated to the channel's audience so files in a hidden channel stay
    // private, matching the message rules. Uploader writes their own folder.
    // DM attachments live under channel 'coach-dm' (a player's upload into
    // their own thread, uid = the player) or 'dm:{playerUid}' (a coach's
    // upload into that player's thread): readable only by that player and
    // their team's per-team coach — never other players, and not the org
    // admin (matches the dms rules). DM channels never hit the chatGroups
    // lookup.
    // Size caps: images 10 MB, videos 100 MB, documents 25 MB.
    match /chat/{teamId}/{channel}/{uid}/{filename} {
      allow read: if request.auth != null && isMemberOfTeam(teamId) && (
        channel == 'team'
        || (channel == 'coach-dm'
              ? (request.auth.uid == uid || isPerTeamCoach(teamId))
              : channel.matches('^dm:.+')
                ? (request.auth.uid == channel.split(':')[1] || isPerTeamCoach(teamId))
                : (isAdminUser()
                   || firestore.get(/databases/(default)/documents/chatGroups/$(channel))
                        .data.get('audienceKeys', ['*']).hasAny(myAudienceKeys())))
      );
      allow write: if request.auth != null
        && isMemberOfTeam(teamId)
        && request.auth.uid == uid
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
          || (request.resource.contentType.matches('application/(pdf|msword|vnd\\.ms-(excel|powerpoint)|vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)|rtf)|text/(plain|csv|rtf)') && request.resource.size < 25 * 1024 * 1024)
        );
    }

    // Legacy chat images uploaded before team-scoped paths existed
    // (chat/{channel}/{uid}/{filename} and chat/{uid}/{filename}).
    // Read-only for anyone with a profile; no new writes.
    match /chat/{channel}/{uid}/{filename} {
      allow read: if hasProfile();
    }
    match /chat/{uid}/{filename} {
      allow read: if hasProfile();
    }

    // Profile photos. Path shape: avatars/{uid}/{filename}. Readable by the
    // owner, the org admin, and anyone who shares a team with the owner (so
    // faces show in the roster / line-ups of their team, but not to the
    // other teams). Only the owner writes to their own folder (image, max
    // 10MB). A coach sets a player's photo from the player's own folder is
    // not possible here, so coaches write under their own uid too and the URL
    // is stored on the target user doc.
    match /avatars/{uid}/{filename} {
      allow read: if request.auth != null && sharesTeamWith(uid);
      // F33: the old photo is deleted when it's replaced (owner only).
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Team branding — e.g. the logo watermarked onto game-day line-ups.
    // Path shape: branding/{uid}/{filename}. Anyone with a profile reads;
    // only a coach writes, to their own folder (image, max 10MB).
    match /branding/{uid}/{filename} {
      allow read: if hasProfile();
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isAdminUser()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Drill photos + diagrams. Path shape: drills/{uid}/{filename}.
    // The drill library is shared across all three Brophy teams, so anyone
    // with a profile can read; only a coach or drill builder uploads, to
    // their own folder, must be an image, max 10MB.
    match /drills/{uid}/{filename} {
      allow read: if hasProfile();
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && canBuildDrills()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Session PDFs (Practice Plans). Path shape: drillPdfs/{uid}/{filename}.
    // The drill library is shared across all three Brophy teams, so anyone
    // with a profile can read; only a coach or drill builder uploads, to
    // their own folder, must be a PDF, max 50MB.
    match /drillPdfs/{uid}/{filename} {
      allow read: if hasProfile();
      allow write: if request.auth != null
        && request.auth.uid == uid
        && canBuildDrills()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf');
    }

    // Coach-authored exercise photos. Path shape: exercises/{uid}/{filename}.
    // Shared exercise library: anyone with a profile reads; only a coach
    // uploads, to their own folder.
    match /exercises/{uid}/{filename} {
      allow read: if hasProfile();
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isAdminUser()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Shared documents library (Train → Documents). Path shape:
    // library/{scope}/{uid}/{filename}, scope = 'all' or a team id.
    // Read: a team-app profile, and membership for team-scoped files.
    // Write: a coach (any coach for 'all', that team's coach otherwise),
    // into their own folder; documents/images/text up to 50 MB.
    match /library/{scope}/{uid}/{filename} {
      allow read: if request.auth != null && hasProfile()
        && (scope == 'all' || isMemberOfTeam(scope));
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (scope == 'all' ? isAdminUser() : isTeamCoach(scope))
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('application/(pdf|msword|rtf|vnd\\.ms-(excel|powerpoint)|vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)|vnd\\.apple\\.(pages|keynote|numbers)|vnd\\.oasis\\.opendocument\\..*)')
          || request.resource.contentType.matches('text/(plain|csv|rtf)'));
    }

    // Team documents (PDF, Office files, images, etc.). Path shape:
    // documents/{teamId}/{uid}/{filename}. Readable only by members of that
    // team; only a coach of the team (or the org admin) writes, under their
    // own uid folder, max 50MB (presentations with media run large). No
    // content-type restriction — the app curates which types coaches can pick.
    match /documents/{teamId}/{uid}/{filename} {
      allow read: if request.auth != null && isMemberOfTeam(teamId);
      allow write: if request.auth != null
        && isTeamCoach(teamId)
        && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024;
    }

    // Legacy team documents uploaded before team-scoped paths existed
    // (documents/{uid}/{filename}). Read-only for anyone with a profile; no new writes.
    match /documents/{uid}/{filename} {
      allow read: if hasProfile();
    }
  }
}
