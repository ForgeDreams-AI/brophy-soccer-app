# Copy this file to .env (gitignored) and fill in real values.
# After changing any VITE_* variable you must restart `npm run dev`.
# NEVER commit a real key. Deploys (Cloudflare Pages) need the same vars
# set as build-time environment variables.

# USDA FoodData Central — free key, instant signup, no card required
# https://fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=

# Firebase Web Push VAPID public key — generate in the BROPHY Firebase
# console (project brophy-soccer-app): Project Settings → Cloud Messaging
# tab → Web configuration → "Generate key pair" → copy the long string here.
# This key is PUBLIC (safe to commit, but kept in env for consistency).
VITE_FIREBASE_VAPID_KEY=
